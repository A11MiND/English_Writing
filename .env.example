PROJECT_NAME=English AI Writing Platform
ENVIRONMENT=local

POSTGRES_DB=english_ai_writing
POSTGRES_USER=english_ai
POSTGRES_PASSWORD=english_ai_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://english_ai:english_ai_password@postgres:5432/english_ai_writing
DATABASE_POOL_ENABLED=false

REDIS_URL=redis://redis:6379/0
MARKING_QUEUE_NAME=marking:jobs
MARKING_WORKER_POLL_TIMEOUT_SECONDS=5

OPENAUTH_TOKEN_URL=http://auth:9000/oauth/token
OPENAUTH_USERINFO_URL=http://auth:9000/userinfo
OPENAUTH_REGISTER_URL=http://auth:9000/internal/users
OPENAUTH_CLIENT_ID=english-ai-writing-web
OPENAUTH_CLIENT_SECRET=local-dev-client-secret
OPENAUTH_SIGNING_SECRET=local-dev-signing-secret
OPENAUTH_REGISTERED_USERS_JSON_FILE=.local/openauth-registered-users.json
SCHOOL_JOIN_CODE=WFJLP-DEMO
