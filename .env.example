PROJECT_NAME=English Writing
ENVIRONMENT=local

# Local Docker database. Replace these values outside local development.
POSTGRES_DB=english_ai_writing
POSTGRES_USER=english_ai
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://english_ai:change-this-database-password@postgres:5432/english_ai_writing
DATABASE_POOL_ENABLED=false

REDIS_URL=redis://redis:6379/0
MARKING_QUEUE_NAME=marking:jobs
MARKING_WORKER_POLL_TIMEOUT_SECONDS=5

# Local development authentication. Replace all secrets before shared deployment.
OPENAUTH_TOKEN_URL=http://auth:9000/oauth/token
OPENAUTH_USERINFO_URL=http://auth:9000/userinfo
OPENAUTH_REGISTER_URL=http://auth:9000/internal/users
OPENAUTH_CLIENT_ID=english-writing-web
OPENAUTH_CLIENT_SECRET=change-this-client-secret
OPENAUTH_SIGNING_SECRET=change-this-signing-secret
OPENAUTH_REGISTERED_USERS_JSON_FILE=.local/openauth-registered-users.json
SCHOOL_JOIN_CODE=DEMO-SCHOOL
OPENAUTH_USERS_JSON='[{"email":"admin@school.example","password_hash":"pbkdf2_sha256$210000$61646d696e2d6c6f63616c2d6465762d73616c74$e4fe9ee3bfd9f8df202dce6718afd34bb408b0cc41393a0051850c011d024c1e","sub":"33333333-3333-4333-8333-333333333333","school_id":"11111111-1111-4111-8111-111111111111","role":"SCHOOL_ADMIN","status":"ACTIVE"},{"email":"teacher@school.example","password_hash":"pbkdf2_sha256$210000$746561636865722d6c6f63616c2d6465762d73616c74$12874bb99e1c8143caf7d020ac70bc29dd6c03152728c759d13b7f90b10e216d","sub":"44444444-4444-4444-8444-444444444444","school_id":"11111111-1111-4111-8111-111111111111","role":"TEACHER","status":"ACTIVE"},{"email":"student@school.example","password_hash":"pbkdf2_sha256$210000$73747564656e742d6c6f63616c2d6465762d73616c74$da04186219872dc88b827139cab6a1ef6a1a26157191433510693e0ee8788692","sub":"55555555-5555-4555-8555-555555555555","school_id":"11111111-1111-4111-8111-111111111111","role":"STUDENT","status":"ACTIVE"}]'
OPENAUTH_SCOPE=openid profile email
OPENAUTH_USER_ID_CLAIM=sub
OPENAUTH_SCHOOL_ID_CLAIM=school_id
OPENAUTH_ROLE_CLAIM=role

GRAMMAR_PROVIDER=languagetool
GRAMMAR_SERVICE_URL=http://grammar-service:8010
GRAMMAR_CACHE_TTL_SECONDS=86400

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional AI provider. Keep API keys empty until configured locally.
LLM_PROVIDER=minimax
LLM_MODEL=MiniMax-M3
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_TIMEOUT_SECONDS=30

# Optional MiniMax read-aloud and image generation.
MINIMAX_API_KEYS=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_SPEECH_VOICE=English_expressive_narrator
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_TIMEOUT_SECONDS=60
MEDIA_STORAGE_DIR=/app/data/media
